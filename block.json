{
    "apiVersion": 2,
    "name": "tiptip/same-posts-block",
    "title": "Same Category Posts",
    "category": "widgets",
    "description": "Show posts related to the current category or other custom post types.",
    "textdomain": "same-posts",
    "supports": {
        "align": true,
        "html": false
    },
    "attributes": {
        "hideTitle": {
            "type": "boolean",
            "default": false
        },
        "title": {
            "type": "string",
            "default": "Same Posts"
        },
        "titleLink": {
            "type": "boolean",
            "default": false
        },
        "disableCSS": {
            "type": "boolean",
            "default": false
        },
        "disableFontStyles": {
            "type": "boolean",
            "default": false
        },
        "disableThemeStyles": {
            "type": "boolean",
            "default": false
        },
        "sortBy": {
            "type": "string",
            "default": "date"
        },
        "ascSortOrder": {
            "type": "boolean",
            "default": false
        },
        "num": {
            "type": "number",
            "default": 0
        },
        "separateCategories": {
            "type": "boolean",
            "default": false
        },
        "numPerCate": {
            "type": "number",
            "default": 0
        },
        "excludeCurrentPost": {
            "type": "boolean",
            "default": false
        },
        "excludeStickyPosts": {
            "type": "boolean",
            "default": false
        },
        "excludeChildren": {
            "type": "boolean",
            "default": false
        },
        "excludeNoChildren": {
            "type": "boolean",
            "default": false
        }
    },
    "usesContext": [ "postId" ],
    "editorScript": "file:./build/index.js",
    "editorStyle": "file:./build/style-index.css",
    "style": "file:./build/style-index.css"
}
